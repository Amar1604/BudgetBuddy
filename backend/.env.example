# Django Backend Environment Variables Example

# Secret key for Django (generate a strong random string for production)
SECRET_KEY=your-secret-key-here

# Enable debug mode for development (set to False in production)
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite if not provided)
# PostgreSQL connection string: postgresql://[user]:[password]@[host]:[port]/[dbname]
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/budgetbuddy_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
